{
  "name": "inquiry-routing-backend",
  "version": "0.0.1",
  "private": true,
  "description": "문의 라우팅 자동화 백엔드 (PoC, 스캐폴딩 단계)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "migrate": "psql \"$DATABASE_URL\" -f migrations/001_create_teams.sql -f migrations/002_create_inquiries.sql -f migrations/003_create_surveys.sql -f migrations/004_create_match_audit_log.sql",
    "seed": "psql \"$DATABASE_URL\" -f seeds/001_teams.sql"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "multer": "^2.3.0"
  }
}
