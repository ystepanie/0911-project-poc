# 실제 값은 이 파일을 복사한 backend/.env 에 채워 넣으세요 (.env는 git에 커밋되지 않습니다).
#
# Phase 12부터 팀별 Chat 웹훅 URL은 여기(.env)가 아니라 backend/data/team-config.json에서 관리합니다
# (팀 관리자 페이지 admin-teams.html에서 저장). team-config.json도 git 미추적이며, 템플릿은
# backend/data/team-config.example.json을 참고하세요.

# 무응답 타임아웃 실제 운영값 (기본은 config.js에 PoC 테스트용 5초로 들어있음, 필요 시 여기서 덮어씀)
# REMINDER_TIMEOUT_MS=7200000
# ESCALATION_TIMEOUT_MS=7200000

# 값이 있으면 LlmReranker가 LiveLlmReranker(실제 Claude API 호출)로 전환되고,
# 없으면 MockLlmReranker(결정적 규칙)를 그대로 씀 (rerankerRegistry.js). API 실패 시 자동으로 Mock 폴백.
# ANTHROPIC_API_KEY=
